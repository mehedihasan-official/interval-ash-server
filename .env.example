# ==========================================================
# Environment Variables Template
# Copy this file to ".env" and fill in the real values.
# Never commit the actual ".env" file to version control.
# ==========================================================

# Server
PORT=5000
NODE_ENV=

# MongoDB
# Full connection string, e.g. mongodb+srv://<user>:<password>@<cluster-url>/<dbName>
MONGODB_URI=

# Optional DNS servers for MongoDB Atlas SRV lookups
DNS_SERVERS=8.8.8.8,8.8.4.4

# CORS - comma separated list of allowed origins (frontend URLs)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173
